# =========================================================================
# AURA environment template.
# Copy to `.env` for local dev, or set each var on Vercel for production.
# Most providers degrade gracefully when their key is missing — features
# light up automatically as soon as the corresponding key is set.
# =========================================================================

# --- Core (REQUIRED) ---
# Neon Postgres connection string (https://neon.tech)
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-random-string
BETTER_AUTH_URL=http://localhost:3000

# Public site URL (used in emails, OG, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000


# --- Admin / Operator (REQUIRED for /admin/* access) ---
# Comma-separated list of emails treated as super-admin. The /admin/users
# panel, plan editor, llm-status page and other operator views are gated
# behind this allowlist. Without it, even your own login can't reach the
# admin surface.
ADMIN_EMAILS=

# Shared secret for one-shot provisioning endpoints
# (POST /api/admin/promote, seed-voices). Generate with:
#   openssl rand -base64 32
MIGRATE_SECRET=


# --- LLM (script generator + AURA Assistant) ---
# Pick one of the providers below; the app prefers Claude if both are set.
# Set LLM_PROVIDER explicitly to override the auto-detect.
# LLM_PROVIDER=claude   # or "gemini"

# Anthropic (Claude) — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
# AURA_CLAUDE_MODEL=claude-sonnet-4-6   # optional override

# Google (Gemini) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# AURA_GEMINI_MODEL=gemini-2.5-pro      # optional override


# --- TTS (voice engine) ---
ELEVENLABS_API_KEY=sk_...


# --- News sources ---
# NewsAPI.org — https://newsapi.org (free 100 req/day)
NEWSAPI_KEY=

# GNews.io — https://gnews.io (free 100 req/day)
GNEWS_KEY=

# NewsData.io — https://newsdata.io (free 200 req/day, paid ~$50/mo).
# Optional. Improves LATAM / lusophone coverage where GNews is thin.
NEWSDATA_KEY=

# The Guardian Open Platform — https://open-platform.theguardian.com
# Optional. Free with registration, generous quota. Adds high-quality
# center-left English coverage as a parallel provider.
GUARDIAN_KEY=


# --- Weather ---
OPENWEATHER_API_KEY=


# --- Payments (Stripe — leave blank to keep paid plans gated behind
# the Early Access form) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_STANDARD=price_...
STRIPE_PRICE_PRO=price_...

# Optional secondary gateway
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox


# --- Email (Resend) ---
# Account: https://resend.com — RESEND_FROM_EMAIL's domain must be
# verified (DKIM/SPF/MX/DMARC in DNS) before any email actually ships.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=AURA <noreply@aura.app>


# --- Audio storage (Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=aura-audio
R2_PUBLIC_BASE_URL=


# --- Background jobs (Inngest) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=


# --- Cron auth ---
# Shared secret used by Vercel Cron Triggers to call /api/cron/* routes.
# Without this set, every cron tick returns 500. Generate with:
#   openssl rand -base64 32
CRON_SECRET=


# --- Studio Pro desktop products (Stripe) ---
# Separate Studio Pro desktop products. Leave blank until their Stripe
# Products/Prices exist; matching subscriptions provision desktop licenses.
STRIPE_PRICE_STUDIO_PRO=
STRIPE_PRICE_STUDIO_ENTERPRISE=

# --- Studio Pro device authentication + commercial licensing ---
# Dedicated HMAC secret for opaque device token hashes. Generate with:
#   openssl rand -base64 32
DEVICE_TOKEN_PEPPER=

# Ed25519 private key used only by AURA to sign offline license leases.
# Generate outside the repository:
#   openssl genpkey -algorithm Ed25519 -out studio-license-private.pem
# Paste the PEM as a protected Vercel environment secret. Export the matching
# public key for embedding in Studio Pro with:
#   openssl pkey -in studio-license-private.pem -pubout -out studio-license-public.pem
STUDIO_LICENSE_PRIVATE_KEY=
STUDIO_LICENSE_KEY_ID=studio-2026-01
