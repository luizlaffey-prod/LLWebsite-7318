{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/trial-warning",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/trial-downgrade",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/automations",
      "schedule": "*/10 * * * *"
    }
  ]
}
