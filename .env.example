# --- Core ---
# Neon Postgres connection string (https://neon.tech)
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-random-string
BETTER_AUTH_URL=http://localhost:3000

# Public site URL (used in emails, OG, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- LLM (script generator) ---
# Pick one of the providers below; the app prefers Claude if both are set.
# Set LLM_PROVIDER explicitly to override the auto-detect.
# LLM_PROVIDER=claude   # or "gemini"

# Anthropic (Claude) — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
# AURA_CLAUDE_MODEL=claude-sonnet-4-6   # optional override

# Google (Gemini) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# AURA_GEMINI_MODEL=gemini-2.5-pro      # optional override

# --- TTS (voice engine) ---
ELEVENLABS_API_KEY=sk_...

# --- News sources ---
NEWSAPI_KEY=
GNEWS_KEY=

# --- Weather ---
OPENWEATHER_API_KEY=

# --- Payments ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_STANDARD=price_...
STRIPE_PRICE_PRO=price_...

# Optional secondary gateway
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# --- Email (Resend) ---
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=AURA <noreply@aura.app>

# --- Audio storage (Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=aura-audio
R2_PUBLIC_BASE_URL=

# --- Background jobs (Inngest) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Cron auth ---
# Shared secret used by Vercel Cron Triggers to call /api/cron/* routes.
# Generate with: openssl rand -base64 32
CRON_SECRET=
